# ==============================================================================
# DocHub 企业级知识库管理平台 - 环境变量模板（严禁将真实密钥提交到 Git）
# 使用方式：复制本文件为 .env 并填入本机真实配置
# ==============================================================================

# --- 运行环境 ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 安全与 JWT（生产/演示请替换为高强度随机密钥） ---
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_SECRET_KEY=CHANGE_ME_CSRF_RANDOM_SECRET

# --- PostgreSQL（强约束：Migration 角色与 Runtime 角色分离，Runtime 禁止 BYPASSRLS） ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=dochub
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dochub_pg_super_dev
POSTGRES_MIGRATOR_USER=app_migrator
POSTGRES_MIGRATOR_PASSWORD=dochub_migrator_dev
POSTGRES_RUNTIME_USER=app_runtime
POSTGRES_RUNTIME_PASSWORD=dochub_runtime_dev

# --- Redis（缓存 + Celery Broker） ---
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=dochub_redis_dev
REDIS_CACHE_DB=0
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_RESULT_DB=2

# --- MinIO（原始文档与解析制品对象存储） ---
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_EXTERNAL_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=dochub_minio_dev
MINIO_SECRET_KEY=dochub_minio_secret_dev
MINIO_SECURE=false
MINIO_BUCKET_RAW=dochub-raw
MINIO_BUCKET_ARTIFACTS=dochub-artifacts

# --- Qdrant（混合检索向量库） ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=dochub_qdrant_dev_key

# --- MinerU 官方 API（仅存服务端，严禁暴露给前端与日志） ---
# 复杂/扫描 PDF 优先走 MinerU 官方 API；L2/L3 受外发策略控制，缺失本地 OCR 时 Fail-Closed
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_VERSION=v4
MINERU_API_KEY=YOUR_MINERU_API_KEY
MINERU_TIMEOUT_SECONDS=60
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_MAX_POLL_ATTEMPTS=120
# 本地 OCR 扩展接口（预留：L2/L3 扫描 PDF 本地处理，未启用时自动阻断 BLOCKED_POLICY）
LOCAL_OCR_ENABLED=false
LOCAL_OCR_ENDPOINT=

# --- OpenAI-compatible LLM Provider ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://100milionseek.top/v1
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120

# --- Embedding Provider（双选择：qwen 官方 API 优先 / local_bge 本地接口） ---
EMBEDDING_PRIMARY_PROVIDER=qwen
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=YOUR_QWEN_API_KEY
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_EMBEDDING_DIMENSIONS=1024

LOCAL_BGE_EMBEDDING_ENABLED=false
LOCAL_BGE_EMBEDDING_URL=http://127.0.0.1:8081/v1
LOCAL_BGE_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_BGE_EMBEDDING_DIMENSIONS=1024

# --- Reranker Provider（双选择：qwen 官方 API 优先 / local_bge 本地接口） ---
RERANKER_PRIMARY_PROVIDER=qwen
QWEN_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
QWEN_RERANK_MODEL=gte-rerank
LOCAL_BGE_RERANK_ENABLED=false
LOCAL_BGE_RERANK_URL=http://127.0.0.1:8082/v1/rerank
LOCAL_BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 可观测性（OpenTelemetry / Prometheus / Loki / Tempo / Grafana） ---
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=dochub-api
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dochub_grafana_dev
