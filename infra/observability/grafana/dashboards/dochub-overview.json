{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "DocHub 企业级知识库平台基础观测总览看板：覆盖 API QPS/延迟、ACL 拒绝、FAQ 缓存命中率、MinerU 解析、Qdrant 检索、LLM 推理及 Celery/Outbox 队列健康状态。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "FastAPI 接口每秒请求数（按状态码分组）",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{job=\"dochub-api\"}[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "title": "API 请求吞吐 (QPS)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "FastAPI 接口 P50 / P95 / P99 响应延迟",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dochub-api\"}[5m])))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dochub-api\"}[5m])))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dochub-api\"}[5m])))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "title": "API 响应延迟 (P50/P95/P99)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "ACL 权限拦截与安全拒绝速率（按拒绝原因分类）",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (reason) (rate(dochub_acl_deny_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "安全拦截：ACL Deny 速率",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "FAQ 快速通道缓存命中率（含 ACL 校验通过后命中）",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(dochub_faq_cache_hits_total[5m])) / clamp_min(sum(rate(dochub_faq_cache_requests_total[5m])), 1e-9)",
          "legendFormat": "FAQ Cache Hit Ratio",
          "refId": "A"
        }
      ],
      "title": "FAQ 缓存命中率",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Qdrant 混合检索与 MinerU 文档解析任务 P95 耗时",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dochub_qdrant_search_duration_seconds_bucket[5m])))",
          "legendFormat": "Qdrant P95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dochub_mineru_task_duration_seconds_bucket[5m])))",
          "legendFormat": "MinerU Parse P95 Latency",
          "refId": "B"
        }
      ],
      "title": "Qdrant 检索 & MinerU 解析耗时 (P95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "LLM 首字延迟 (TTFT) 与 Token 吞吐消耗",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dochub_llm_ttft_seconds_bucket[5m])))",
          "legendFormat": "LLM TTFT P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dochub_llm_total_duration_seconds_bucket[5m])))",
          "legendFormat": "LLM Total P95",
          "refId": "B"
        }
      ],
      "title": "LLM 首字延迟 (TTFT) & 总耗时",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Celery 队列积压深度与 Outbox / 索引同步延迟",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (queue) (dochub_celery_queue_depth)",
          "legendFormat": "Queue: {{queue}}",
          "refId": "A"
        },
        {
          "expr": "max(dochub_outbox_lag_seconds)",
          "legendFormat": "Outbox Lag (s)",
          "refId": "B"
        },
        {
          "expr": "max(dochub_index_lag_seconds)",
          "legendFormat": "Index Lag (s)",
          "refId": "C"
        }
      ],
      "title": "异步流水线：Celery 队列深度与 Outbox / 索引延迟",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "来自 Loki 的 DocHub 最近错误与告警日志流（已脱敏）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service_name=~\"dochub-.*\"} |= \"ERROR\"",
          "refId": "A"
        }
      ],
      "title": "DocHub 错误日志流 (Loki)",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "dochub",
    "observability",
    "rag",
    "security"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "DocHub 平台核心运行与安全观测总览",
  "uid": "dochub-overview",
  "version": 1
}
